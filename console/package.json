{
  "name": "implementation-harness-console",
  "productName": "Implementation Harness",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:integration": "playwright test",
    "test:integration:headed": "playwright test --headed",
    "test": "npm run test:unit && npm run test:integration",
    "desktop:dev": "node scripts/build-desktop.mjs && node scripts/desktop.mjs --dev",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/desktop.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.cjs --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.cjs",
    "test:desktop": "node scripts/build-desktop.mjs && playwright test --config playwright.desktop.config.ts",
    "test:desktop:policy": "node --test tests/desktop-policy/*.test.cjs",
    "desktop:dist:signed": "npm run desktop:build && electron-builder --config electron-builder.cjs --mac --publish never -c.forceCodeSigning=true"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "geist": "^1.7.2",
    "next": "^16.3.4",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1"
  },
  "description": "Application locale pour piloter les workflows Claude Code",
  "main": "electron/main.cjs"
}
