#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" = /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

repo_root="$(cd -P "$(dirname "$script_path")/.." && pwd)"
console_dir="$repo_root/console"
env_file="${IMPL_ENV_FILE:-$repo_root/.env}"

# A .env is data, never a script: it is parsed instead of sourced, and the
# last assignment wins, like process.loadEnvFile on the server side.
env_file_value() {
  local key="$1" line value
  [[ -f "$env_file" ]] || return 0
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$key[[:space:]]*=" "$env_file" 2>/dev/null | tail -n 1 || true)"
  [[ -n "$line" ]] || return 0
  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"
  case "$value" in
    "'"*) value="${value#\'}"; value="${value%%\'*}" ;;
    '"'*) value="${value#\"}"; value="${value%%\"*}" ;;
    *) value="${value%%#*}"; value="${value%"${value##*[![:space:]]}"}" ;;
  esac
  printf '%s' "$value"
}

app_port="${IMPL_PORT:-$(env_file_value IMPL_PORT)}"
app_port="${app_port:-3210}"
app_host="${IMPL_HOST:-$(env_file_value IMPL_HOST)}"
app_host="${app_host:-127.0.0.1}"
no_open="${IMPL_NO_OPEN:-$(env_file_value IMPL_NO_OPEN)}"
no_open="${no_open:-0}"
app_url="http://$app_host:$app_port"
tls_cert="${IMPL_TLS_CERT:-$(env_file_value IMPL_TLS_CERT)}"
if [[ -n "$tls_cert" ]]; then app_url="https://$app_host:$app_port"; fi
public_url="${IMPL_PUBLIC_URL:-$(env_file_value IMPL_PUBLIC_URL)}"
if [[ -n "$public_url" ]]; then app_url="${public_url%/}"; fi
launch_url="$app_url"
control_data="${IMPL_DATA_DIR:-$(env_file_value IMPL_DATA_DIR)}"
control_data="${control_data:-$console_dir/data}"
if [[ "$control_data" != /* ]]; then control_data="$console_dir/$control_data"; fi
export IMPL_CONTROL_TOKEN_FILE="$control_data/control-token"
control_token() { if [[ -f "$IMPL_CONTROL_TOKEN_FILE" ]]; then cat "$IMPL_CONTROL_TOKEN_FILE"; fi; }
control_header() { printf 'Authorization: Bearer %s' "$(control_token)"; }

program="$(basename "$0")"
command="${1:-}"

# Commands answered by the terminal client (console/cli), which talks to the
# running server like its page does. Listed here so that a mistyped command is
# refused before anything starts.
client_commands=" run runs show watch attach answer trust tell abort close feedback queue incident worktree docs evidence metrics recipe findings proposals improvements repos "
is_client_command() {
  [[ -n "$1" && "$client_commands" == *" $1 "* ]]
}

usage() {
  cat <<USAGE
Usage: $program [command]

  start     starts the interface in the background and opens the browser (default)
  demo      starts the interface on a simulated scenario, with no repository or ticket
  restart   stops the running server then starts the compiled version again
  stop      stops the running server
  status    says whether a server is listening and whether it serves the build on disk
  config    reads and changes the local configuration (.env)
  improve   handles the self-improvement feedback with Claude Code
  help      shows this help

Driving the runs from this terminal, without the browser:

  run       starts a run on a ticket, or queues several tickets as a batch
  runs      lists the runs, the queue, the kept worktrees and the watcher's tickets
  show      shows one run: step, agents, plan, decision waiting, incident
  watch     follows a run until it ends and asks its decisions, or follows every run
  attach    opens the terminal of a run's session
  answer    answers the decision a run waits on
  trust     answers the folder trust dialog of a session
  tell      sends an instruction to the session of a run
  abort     stops a run and its session
  close     removes an ended run from the list
  feedback  leaves feedback on a run for the improvement loop
  queue     shows the queue and acts on a waiting launch
  incident  shows the open incident of a run, or acts on it
  worktree  removes the worktree an ended run left
  docs      lists the documents of a run, or prints one
  evidence  shows the acceptance criteria and what verifies each
  metrics   shows what each run cost and delivered
  recipe    shows or drops the runtime recipe kept for a repository
  findings  shows or drops the review findings kept for a repository
  proposals shows the watcher's tickets that were not queued
  improvements  shows the improvement branches and decides on one
  repos     lists the checkouts found, and the one a ticket goes to

Each one details its arguments: $program run --help
run starts the server when none is listening, without opening the browser.
IMPL_CONSOLE_URL names a console listening elsewhere, a tunnel to another
machine for instance (in effect: ${IMPL_CONSOLE_URL:-$app_url}).

restart accepts the demo mode: $program restart demo
config accepts its own subcommands: $program config help

Configuration ($env_file):
  IMPL_SEARCH_ROOTS              roots searched for the checkouts
  IMPL_SELF_IMPROVEMENT_AUTORUN  self-audit and automatic merge of its improvements
  IMPL_REMOTE_CONTROL=false      run without Remote Control
  IMPL_PORT                      listening port (in effect: $app_port)
  IMPL_HOST                      listening interface (in effect: $app_host)
  IMPL_NO_OPEN=1                 do not open the browser
  IMPL_DEMO_STEP_MS              duration of a demo mode step
  IMPL_MAX_CONCURRENT_RUNS       runs held in parallel (1 to 10)

A variable set in the shell wins over the .env, which wins over the
default. Change these values: $program config

Exit codes of status: 0 listening and consistent, 1 listening but
inconsistent, 3 stopped.
USAGE
}

reject() {
  printf '%s\n\n' "$1" >&2
  usage >&2
  exit 1
}

case "$command" in
  help|--help|-h) usage; exit 0 ;;
  ""|start|demo|restart|stop|status|config|improve) ;;
  *) is_client_command "$command" || reject "Unknown command: $command" ;;
esac

if [[ "$command" != "restart" && "$command" != "config" && $# -gt 1 ]] && ! is_client_command "$command"; then
  reject "Too many arguments: $*"
fi

if [[ "$command" == "config" ]]; then
  if ! command -v node >/dev/null 2>&1; then
    printf 'Missing prerequisite: node\n' >&2
    exit 1
  fi
  shift
  exec node "$repo_root/bin/config.mjs" "$@"
fi

if [[ "$command" == "improve" ]]; then
  mkdir -p "$console_dir/data/feedback/pending"
  cd "$repo_root"
  exec claude --plugin-dir "$repo_root" --name "implementation-factory self-improvement" "/implementation-factory:improve $console_dir/data/feedback"
fi

listening_pids() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -t -nP -iTCP:"$app_port" -sTCP:LISTEN 2>/dev/null || true
  else
    pgrep -f "tsx server/index.ts" 2>/dev/null || true
  fi
}

stop_server() {
  local pids
  pids="$(listening_pids)"
  if [[ -z "$pids" ]]; then
    printf 'No Implementation Factory server listening on port %s.\n' "$app_port"
    return 0
  fi
  printf 'Stopping the Implementation Factory server (PID %s)...\n' "$(echo $pids)"
  kill $pids 2>/dev/null || true
  for _ in {1..40}; do
    if [[ -z "$(listening_pids)" ]]; then
      return 0
    fi
    sleep 0.25
  done
  printf 'Forced stop.\n'
  kill -9 $(listening_pids) 2>/dev/null || true
  sleep 0.5
  if [[ -n "$(listening_pids)" ]]; then
    printf 'Port %s is still in use. Free it by hand before starting again.\n' "$app_port" >&2
    exit 1
  fi
}

if [[ "$command" == "stop" ]]; then
  stop_server
  exit 0
fi

# The running server serves the Next.js manifest of the build present when it
# started. After a rebuild, its style sheets point to deleted files: the page
# shows unstyled. So the assets actually served are checked, not only the
# presence of a process.
status_report() {
  local pids
  pids="$(listening_pids)"
  if [[ -z "$pids" ]]; then
    printf 'Stopped. No server listening on port %s.\n' "$app_port"
    return 3
  fi
  printf 'Server    : listening on %s (PID %s)\n' "$app_url" "$(echo $pids)"

  local build_id="(unknown)"
  if [[ -f "$console_dir/.next/BUILD_ID" ]]; then
    build_id="$(cat "$console_dir/.next/BUILD_ID")"
  fi
  printf 'Build     : %s on disk\n' "$build_id"

  if ! command -v curl >/dev/null 2>&1; then
    printf 'Assets    : not checked, curl is missing.\n'
    return 0
  fi

  local runs
  if ! runs="$(curl -fsS -H "$(control_header)" "$app_url/api/runs" 2>/dev/null)" || ! printf '%s' "$runs" | grep -q '"runs"'; then
    printf 'API       : /api/runs does not answer like the factory.\n' >&2
    printf 'Another program may be using port %s.\n' "$app_port" >&2
    return 1
  fi
  printf 'API       : answers\n'
  # A factory holds several runs: the status says how many hold a slot, how
  # many wait, and out of how many slots.
  if command -v node >/dev/null 2>&1; then
    printf '%s' "$runs" | node -e '
      let raw = ""; process.stdin.on("data", (chunk) => { raw += chunk; });
      process.stdin.on("end", () => {
        const { runs = [], queued = [], maxConcurrentRuns = 0 } = JSON.parse(raw);
        const holding = runs.filter((run) => run.takesSlot).length;
        console.log(`Runs      : ${holding}/${maxConcurrentRuns} slots taken, ${runs.length} shown, ${queued.length} queued`);
      });' 2>/dev/null || true
  fi

  local page assets missing=0 total=0 asset
  page="$(curl -fsS "$app_url/" 2>/dev/null || true)"
  assets="$(printf '%s' "$page" | grep -o '/_next/static/[^"\\]*' | sort -u || true)"
  if [[ -z "$assets" ]]; then
    printf 'Assets    : no asset referenced, nothing to check.\n'
    return 0
  fi
  while IFS= read -r asset; do
    total=$((total + 1))
    if [[ "$(curl -s -o /dev/null -w '%{http_code}' "$app_url$asset")" != "200" ]]; then
      missing=$((missing + 1))
    fi
  done <<< "$assets"

  if (( missing > 0 )); then
    printf 'Assets    : %s of %s not found.\n' "$missing" "$total" >&2
    printf 'The server serves a build older than the one on disk.\n' >&2
    printf 'Restart it: %s restart\n' "$program" >&2
    return 1
  fi
  printf 'Assets    : %s served, build up to date\n' "$total"
  return 0
}

if [[ "$command" == "status" ]]; then
  set +e
  status_report
  exit $?
fi

if [[ "$command" == "restart" ]]; then
  shift
  command="${1:-}"
  case "$command" in
    ""|start|demo) ;;
    *) reject "restart only accepts the demo mode, got: $command" ;;
  esac
  if [[ $# -gt 1 ]]; then
    reject "Too many arguments: $*"
  fi
  stop_server
fi

if [[ "$command" == "demo" ]]; then
  launch_url="$app_url/?demo=1"
fi

open_app() {
  if [[ "$no_open" == "1" ]]; then return; fi
  if command -v open >/dev/null 2>&1; then
    open "$launch_url#access=$(control_token)"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$launch_url#access=$(control_token)" >/dev/null 2>&1
  fi
}

factory_answers() {
  command -v curl >/dev/null 2>&1 && curl -fsS -H "$(control_header)" "$app_url/api/runs" >/dev/null 2>&1
}

# Starts the server in the background and returns once it answers: 0 when it
# does, 2 when it is still starting after the wait. A server that stops during
# its startup ends the script.
start_server() {
  local data_dir log_file server_pid
  data_dir="${IMPL_DATA_DIR:-$(env_file_value IMPL_DATA_DIR)}"
  data_dir="${data_dir:-data}"
  # The caller's directory is kept: the terminal client reads relative paths from it.
  log_file="$(cd "$console_dir" && mkdir -p "$data_dir" && cd "$data_dir" && pwd)/server.log"

  # The server outlives this script: nohup keeps it through the terminal closing,
  # and stdin from /dev/null keeps a background read from stopping it.
  (cd "$console_dir" && PORT="$app_port" IMPL_HOST="$app_host" exec nohup npm run start </dev/null >"$log_file" 2>&1) &
  server_pid=$!
  disown "$server_pid" 2>/dev/null || true

  for _ in {1..120}; do
    if factory_answers; then
      open_app
      printf 'Implementation Factory started at %s\n' "$app_url"
      printf 'Logs: %s\n' "$log_file"
      printf 'Stop it with: %s stop\n' "$program"
      return 0
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
      printf 'The server stopped during startup. End of %s:\n\n' "$log_file" >&2
      tail -n 20 "$log_file" >&2
      exit 1
    fi
    sleep 0.25
  done

  printf 'The server is still starting (PID %s). Follow it: tail -f %s\n' "$server_pid" "$log_file"
  return 2
}

if is_client_command "$command"; then
  if ! command -v node >/dev/null 2>&1; then
    printf 'Missing prerequisite: node\n' >&2
    exit 1
  fi
  if [[ ! -x "$console_dir/node_modules/.bin/tsx" ]]; then
    printf 'The console is not installed. Run: cd %s && npm install\n' "$console_dir" >&2
    exit 1
  fi
  # A launch needs a server and says so by starting one. Reading commands start
  # nothing: a server that starts also starts whatever its queue held.
  if [[ "$command" == "run" && -z "${IMPL_CONSOLE_URL:-}" ]] && ! factory_answers; then
    no_open=1
    start_server >&2 || exit 1
  fi
  IMPL_CONSOLE_URL="${IMPL_CONSOLE_URL:-$app_url}" IMPL_LOCAL_CONSOLE_URL="$app_url" IMPL_PORT="$app_port" IMPL_CONTROL_TOKEN="${IMPL_CONTROL_TOKEN:-$(env_file_value IMPL_CONTROL_TOKEN)}" IMPL_PROGRAM="$program" \
    exec "$console_dir/node_modules/.bin/tsx" --tsconfig "$console_dir/tsconfig.json" "$console_dir/cli/index.ts" "$@"
fi

if factory_answers; then
  open_app
  printf 'Implementation Factory is already available at %s\n' "$app_url"
  exit 0
fi

start_server || true
