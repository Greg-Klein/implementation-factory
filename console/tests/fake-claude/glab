#!/usr/bin/env node
// Stands in for `glab` in the test suites, which must never reach a real
// GitLab. It answers two questions from files a test writes in FAKE_GLAB_DIR:
// the state of a merge request, `merge-request-<iid>` holding `opened`,
// `merged` or `closed`, and the links of an issue, `issue-links-<iid>` holding
// the JSON list GitLab would answer. Anything else fails, the way `glab` does
// without a network.
import { appendFileSync, existsSync, readFileSync } from "node:fs";
import path from "node:path";

// Only the call the console makes is answered: `api --hostname <host> <endpoint>`, nothing before,
// between or after. A forgotten host or an argument slipped in beside the endpoint fails here, where
// reading the endpoint alone let both through. Every call is kept in `calls.jsonl` for a test to read.
const argv = process.argv.slice(2);
if (process.env.FAKE_GLAB_DIR && existsSync(process.env.FAKE_GLAB_DIR)) {
  try { appendFileSync(path.join(process.env.FAKE_GLAB_DIR, "calls.jsonl"), `${JSON.stringify(argv)}\n`); } catch { /* the test reads what it can */ }
}
const expected = argv.length === 4 && argv[0] === "api" && argv[1] === "--hostname" && /^[a-z0-9.-]+(:\d+)?$/i.test(argv[2]) && argv[3].startsWith("projects/");
if (!expected) {
  process.stderr.write(`fake glab: unexpected arguments ${JSON.stringify(argv)}\n`);
  process.exit(2);
}
const endpoint = argv[3];
const mergeRequest = endpoint.match(/\/merge_requests\/(\d+)$/)?.[1];
const linkedIssue = endpoint.match(/\/issues\/(\d+)\/links$/)?.[1];
const name = mergeRequest ? `merge-request-${mergeRequest}` : linkedIssue ? `issue-links-${linkedIssue}` : undefined;
const file = name && process.env.FAKE_GLAB_DIR ? path.join(process.env.FAKE_GLAB_DIR, name) : undefined;
if (!file || !existsSync(file)) {
  process.stderr.write("fake glab: nothing to answer\n");
  process.exit(1);
}
const content = readFileSync(file, "utf8").trim();
process.stdout.write(mergeRequest ? JSON.stringify({ iid: Number(mergeRequest), state: content }) : content);
