# Comma-separated directories scanned, up to two levels deep, for the checkout of a GitLab or GitHub issue.
IMPL_SEARCH_ROOTS='~/workspace'

# Permission mode every run is started with; 'manual' asks before each tool and stops an unattended run.
IMPL_PERMISSION_MODE='auto'

# Language of what the workflow writes for people (questions, reports, merge request text): 'en' or 'fr'. The interface itself is in English.
IMPL_LANGUAGE='en'

# Open a self-improvement session at the end of a run that proved something went wrong, and merge its branch once the checks and an independent judge agree.
IMPL_SELF_IMPROVEMENT_AUTORUN='true'

# Set to 'false' to start a run without Remote Control, which makes its terminal reachable from claude.ai on your own account.
IMPL_REMOTE_CONTROL='true'

# Port the local server and the browser use.
IMPL_PORT='3210'

# Network interface the local server binds to.
IMPL_HOST='127.0.0.1'

# Set to 1 to start without opening the browser.
IMPL_NO_OPEN='0'

# How many Claude Code sessions the console holds at once; further launches wait in a queue.
IMPL_MAX_CONCURRENT_RUNS='3'

# Minutes the analysis of a batch of tickets may take per repository; past it, the tickets of that repository run one at a time.
IMPL_SCHEDULE_TIMEOUT_MINUTES='5'

# Absolute path of the file an outside watcher keeps up to date with the tickets to propose; leave empty for ticket-proposals.json in the data directory.
IMPL_TICKET_PROPOSALS_FILE=''

# Comma-separated names of ignored dependency directories the worktree of a run takes from the main checkout, at any depth: cloned copy-on-write, symlinked where a clone is not possible. Never list build outputs.
IMPL_WORKTREE_DEPENDENCY_DIRS='node_modules'

# Comma-separated ignored files copied from the main checkout into the worktree of a run: a name pattern such as .env*, or a path from the repository root.
IMPL_WORKTREE_COPY_FILES='.env*,.claude/settings.local.json'

# Minutes without any progress before the console voices a doubt about a run in progress. A doubt only: it never stops nor restarts anything.
IMPL_STALL_MINUTES='10'

# Name of the GitLab work item status a run gives its ticket when it creates the branch. Status names belong to the GitLab group; GitHub issues have none.
IMPL_GITLAB_STATUS_STARTED='In progress'

# Name of the GitLab work item status a run gives its ticket once the merge request is open.
IMPL_GITLAB_STATUS_MERGE_REQUEST='In progress - Merge request'

# Duration of each step of the simulated scenario, in milliseconds.
IMPL_DEMO_STEP_MS='5000'
