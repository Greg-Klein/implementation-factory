#!/usr/bin/env node
// Stands in for Claude Code in the integration suite: a session that starts,
// waits at its prompt and quits when the console stops it. The tests write the
// workflow's documents and post its hooks themselves, so the real ingestion
// path runs without a model. What the console types into the session is kept,
// one file per run, for a test to count what was submitted.
//
// Started under FAKE_CLAUDE_UNTRUSTED_ROOT, it first draws the folder trust
// dialog, byte for byte what Claude Code 2.1.288 wrote (the fixture of the unit
// tests), and waits for an answer: Enter on the option under the cursor, the
// arrows to move it, Escape to leave. Only the frame is the real one. How the
// real dialog redraws and what it does with each key was not observed.
//
// Called with `-p` and the schedule command, it stands in for a headless
// scheduling session instead: it reads the input file and writes the output
// file of contracts/schedule.md, shaped by the fixture FAKE_CLAUDE_SCHEDULE
// names, then exits, and never draws the dialog: a headless session has no terminal
// to draw it on. Without a fixture file every ticket is predicted with
// high confidence and no edge. The fixture is JSON:
//   { "mode": "fail" }     exits without writing anything
//   { "mode": "hang" }     never answers, for the console to time out
//   { "mode": "invalid" }  writes a file the contract refuses
//   { "edges": [{ "a": 1, "b": 2, "kind": "overlap", "reason": "…" }], "confidence": { "3": "low" } }
// where tickets are named by their number. Tickets are invented by the tests.
//
// A line typed into the session that holds `fake-hook:` followed by a hook
// payload in JSON is handed to the real `hooks/emit.mjs`, under the environment
// the console gave the session: the one way a test sends a hook down the whole
// chain (the address and the secret the console built, the emitter, the server)
// instead of posting it itself.
import { spawn } from "node:child_process";
import { appendFileSync, existsSync, readFileSync, realpathSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const argv = process.argv.slice(2);
const scheduleCall = argv.includes("-p") ? (argv[argv.indexOf("--") + 1] ?? "").match(/^\/implementation-factory:schedule (\S+) (\S+)$/) : null;
if (argv.includes("-p")) {
  // A prompt swallowed by a variadic flag never reaches this point as the schedule command.
  if (!scheduleCall) process.exit(2);
  const [, inputPath, outputPath] = scheduleCall;
  const fixtureFile = process.env.FAKE_CLAUDE_SCHEDULE;
  const fixture = fixtureFile && existsSync(fixtureFile) ? JSON.parse(readFileSync(fixtureFile, "utf8")) : {};
  const input = JSON.parse(readFileSync(inputPath, "utf8"));
  // What the session was started with, for a test to check it reports to no run.
  if (process.env.FAKE_CLAUDE_INPUT_DIR) {
    try {
      appendFileSync(path.join(process.env.FAKE_CLAUDE_INPUT_DIR, "schedule-calls.jsonl"), `${JSON.stringify({
        cwd: process.cwd(), argv, input, runId: process.env.IMPL_RUN_ID ?? null, hookUrl: process.env.IMPL_HOOK_URL ?? null,
      })}\n`);
    } catch { /* the test reads what it can */ }
  }
  if (fixture.mode === "hang") {
    setInterval(() => {}, 1 << 30);
  } else {
    if (fixture.mode === "invalid") writeFileSync(outputPath, JSON.stringify({ tickets: [] }));
    else if (fixture.mode !== "fail") {
      const number = (url) => url.split("/").pop();
      const urls = [...input.tickets, ...(input.known ?? [])].map((ticket) => ticket.issue_url);
      const url = (iid) => urls.find((candidate) => number(candidate) === String(iid));
      writeFileSync(outputPath, JSON.stringify({
        tickets: input.tickets.map((ticket) => ({
          issue_url: ticket.issue_url, areas: [], files: [`src/ticket-${number(ticket.issue_url)}.ts`],
          confidence: fixture.confidence?.[number(ticket.issue_url)] ?? "high",
          summary: `Ticket ${number(ticket.issue_url)} du lot de test.`,
        })),
        // An edge needs both its tickets in the input, and at least one of them new.
        edges: (fixture.edges ?? []).filter((edge) => url(edge.a) && url(edge.b) && [edge.a, edge.b].some((iid) => input.tickets.some((ticket) => ticket.issue_url === url(iid)))).map((edge) => ({
          a: url(edge.a), b: url(edge.b), kind: edge.kind,
          ...(edge.order ? { order: edge.order.map(url) } : {}), reason: edge.reason,
        })),
      }));
    }
    process.stdout.write(JSON.stringify({ type: "result", result: fixture.mode === "fail" ? "schedule failed: fixture" : "schedule: done" }));
    process.exit(fixture.mode === "fail" ? 1 : 0);
  }
} else {
const inputDirectory = process.env.FAKE_CLAUDE_INPUT_DIR;
if (inputDirectory && process.env.IMPL_RUN_ID) {
  const log = path.join(inputDirectory, `${process.env.IMPL_RUN_ID}.log`);
  // Where the console started the session and what it told it about its worktree, for a test to read.
  try {
    writeFileSync(path.join(inputDirectory, `${process.env.IMPL_RUN_ID}.session.json`), JSON.stringify({
      cwd: process.cwd(), worktree: process.env.IMPL_RUN_WORKTREE, repository: process.env.IMPL_SOURCE_REPOSITORY,
      branch: process.env.IMPL_SOURCE_BRANCH, dependencies: process.env.IMPL_WORKTREE_DEPENDENCIES, baseBranch: process.env.IMPL_BASE_BRANCH, ticketBaseBranch: process.env.IMPL_TICKET_BASE_BRANCH, deliveryProjects: process.env.IMPL_DELIVERY_PROJECTS, argv,
    }));
  } catch { /* the test reads what it can */ }
  process.stdin.on("data", (chunk) => { try { appendFileSync(log, chunk); } catch { /* the test reads what it can */ } });
}
const emitter = fileURLToPath(new URL("../../../hooks/emit.mjs", import.meta.url));
let typed = "";
process.stdin.on("data", (chunk) => {
  typed = (typed + chunk.toString()).slice(-20_000);
  for (let end = typed.search(/[\r\n]/); end >= 0; end = typed.search(/[\r\n]/)) {
    const line = typed.slice(0, end);
    typed = typed.slice(end + 1);
    const at = line.indexOf("fake-hook:");
    if (at < 0) continue;
    const hook = spawn(process.execPath, [emitter], { env: process.env, stdio: ["pipe", "ignore", "ignore"] });
    hook.on("error", () => { /* the test sees the hook never arrived */ });
    hook.stdin.end(line.slice(at + "fake-hook:".length));
  }
});
const quit = () => process.exit(0);
process.on("SIGHUP", quit);
process.on("SIGTERM", quit);
setInterval(() => {}, 1 << 30);

const real = (directory) => { try { return realpathSync(directory); } catch { return directory; } };
const untrustedRoot = process.env.FAKE_CLAUDE_UNTRUSTED_ROOT;
const untrusted = Boolean(untrustedRoot) && (real(process.cwd()) + path.sep).startsWith(real(untrustedRoot) + path.sep);

/** Long enough to read as a screen of its own, the way the real welcome screen replaces the dialog. */
function ready() {
  const rule = "─".repeat(120);
  process.stdout.write(`\u001b[2J\u001b[H${rule}\r\n fake claude ready\r\n ${real(process.cwd())}\r\n${rule}\r\n ❯ \r\n${rule}\r\n ⏵⏵ auto mode on (shift+tab to cycle)\r\n`);
}

if (!untrusted) {
  process.stdout.write("fake claude ready\r\n");
} else {
  const fixture = JSON.parse(readFileSync(new URL("../unit/fixtures/trust-dialog.json", import.meta.url), "utf8"));
  for (const chunk of fixture.chunks) process.stdout.write(chunk.split("/private/tmp/trust-fixture").join(real(process.cwd())));
  process.stdin.setRawMode?.(true);
  let selected = "no";
  const options = () => {
    const mark = (option) => `\u001b[2K${selected === option ? "\u001b[2G❯" : ""}`;
    process.stdout.write(`\r${mark("no")}\u001b[4GNo,\u001b[8Gexit\r\r\n${mark("yes")}\u001b[4GYes,\u001b[9GI\u001b[11Gtrust\u001b[17Gthis\u001b[22Gfolder\u001b[1A`);
  };
  const onKey = (chunk) => {
    const key = chunk.toString();
    if (key === "\u001b[B" || key === "\u001b[A") { selected = selected === "no" ? "yes" : "no"; options(); return; }
    if (key === "\u001b" || key === "\u0003") process.exit(1);
    if (key !== "\r") return;
    if (selected === "no") process.exit(1);
    process.stdin.off("data", onKey);
    ready();
  };
  process.stdin.on("data", onKey);
}
}
