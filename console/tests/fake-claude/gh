#!/usr/bin/env node
// Stands in for `gh` in the test suites, which must never reach a real GitHub.
// It answers two questions from files a test writes in FAKE_GH_DIR: the state
// of a pull request, `pull-request-<number>` holding `open`, `merged` or
// `closed`, and the dependencies of an issue, `issue-<number>-blocked_by` and
// `issue-<number>-blocking` holding the JSON list GitHub would answer.
// Anything else fails, the way `gh` does without a network.
import { appendFileSync, existsSync, readFileSync } from "node:fs";
import path from "node:path";

// Only the call the console makes is answered: `api --hostname <host> <endpoint>`, nothing before,
// between or after. A forgotten host or an argument slipped in beside the endpoint fails here, where
// reading the endpoint alone let both through. Every call is kept in `calls.jsonl` for a test to read.
const argv = process.argv.slice(2);
if (process.env.FAKE_GH_DIR && existsSync(process.env.FAKE_GH_DIR)) {
  try { appendFileSync(path.join(process.env.FAKE_GH_DIR, "calls.jsonl"), `${JSON.stringify(argv)}\n`); } catch { /* the test reads what it can */ }
}
const expected = argv.length === 4 && argv[0] === "api" && argv[1] === "--hostname" && /^[a-z0-9.-]+(:\d+)?$/i.test(argv[2]) && argv[3].startsWith("repos/");
if (!expected) {
  process.stderr.write(`fake gh: unexpected arguments ${JSON.stringify(argv)}\n`);
  process.exit(2);
}
const endpoint = argv[3];
const pullRequest = endpoint.match(/\/pulls\/(\d+)$/)?.[1];
const dependency = endpoint.match(/\/issues\/(\d+)\/dependencies\/(blocked_by|blocking)(?:\?|$)/);
const name = pullRequest ? `pull-request-${pullRequest}` : dependency ? `issue-${dependency[1]}-${dependency[2]}` : undefined;
const file = name && process.env.FAKE_GH_DIR ? path.join(process.env.FAKE_GH_DIR, name) : undefined;
if (!file || !existsSync(file)) {
  process.stderr.write("fake gh: nothing to answer\n");
  process.exit(1);
}
const content = readFileSync(file, "utf8").trim();
if (dependency) process.stdout.write(content);
// GitHub has no `merged` state: a merge is a closed pull request with `merged` set.
else process.stdout.write(JSON.stringify({ number: Number(pullRequest), state: content === "open" ? "open" : "closed", merged: content === "merged" }));
