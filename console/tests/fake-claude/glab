#!/usr/bin/env node
// Stands in for `glab` in the integration suite, which must never reach a real
// GitLab. It answers one question, the state of a merge request, from a file a
// test writes: `FAKE_GLAB_DIR/merge-request-<iid>` holding `opened`, `merged`
// or `closed`. Anything else fails, the way `glab` does without a network.
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";

const endpoint = process.argv.slice(2).find((argument) => argument.startsWith("projects/")) ?? "";
const mergeRequest = endpoint.match(/\/merge_requests\/(\d+)$/)?.[1];
const file = mergeRequest && process.env.FAKE_GLAB_DIR ? path.join(process.env.FAKE_GLAB_DIR, `merge-request-${mergeRequest}`) : undefined;
if (!file || !existsSync(file)) {
  process.stderr.write("fake glab: nothing to answer\n");
  process.exit(1);
}
process.stdout.write(JSON.stringify({ iid: Number(mergeRequest), state: readFileSync(file, "utf8").trim() }));
